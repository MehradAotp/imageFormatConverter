{
  "manifest_version": 3,
  "name": "Image Format Converter Pro",
  "version": "2.0.0",
  "description": "A privacy-first professional image toolbox for converting, compressing, and batch-exporting web images.",
  "permissions": ["contextMenus", "downloads", "storage", "notifications", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "Open Image Converter Pro", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start" }],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
